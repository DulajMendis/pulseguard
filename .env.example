# PulseGuard Environment Variables

# Application
NEXT_PUBLIC_APP_URL=https://pulseguard.vercel.app

# Storage
DATA_FILE_PATH=/tmp/pulseguard_monitors.json

# Stripe Payments (Optional for live checkout)
NEXT_PUBLIC_STRIPE_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_LIFETIME=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Alerting defaults
DEFAULT_ALERT_EMAIL=
